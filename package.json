{
  "name": "serverlife",
  "version": "0.33.0",
  "description": "Teleport & SSH terminal, file manager and multi-exec for macOS",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "npm run build && env -u ELECTRON_RUN_AS_NODE electron . --enable-logging",
    "rebuild": "electron-rebuild -f -w node-pty -w @serialport/bindings-cpp",
    "icon": "node tools/make-icon.mjs",
    "prepack": "npm run rebuild && npm run build && npm run icon",
    "pack": "npm run prepack && electron-builder --dir",
    "dist:mac": "npm run prepack && electron-builder --mac --arm64",
    "dist:mac:universal": "npm run prepack && electron-builder --mac --arm64 --x64",
    "dist:linux": "npm run prepack && electron-builder --linux --x64 --arm64",
    "dist:win": "npm run prepack && electron-builder --win --x64",
    "dist:all": "npm run prepack && electron-builder --mac --arm64 --linux --x64 --arm64 --win --x64",
    "run-debug": "npm run build && env -u ELECTRON_RUN_AS_NODE electron . --remote-debugging-port=9222"
  },
  "author": {
    "name": "Steven Martin",
    "email": "stevenGravy@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "1.71.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "js-yaml": "^5.4.1",
    "node-pty": "^1.2.0-beta.15",
    "serialport": "^13.0.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "node-pty@1.2.0-beta.18": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "ServerLife",
  "build": {
    "appId": "dev.serverlife.app",
    "productName": "ServerLife",
    "copyright": "Copyright © 2026 ServerLife",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "src/renderer/app.js",
      "src/renderer/vendor/**/*",
      "src/renderer/fonts/**/*",
      "mcp/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@serialport/bindings-cpp/**",
      "mcp/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Teleport & SSH terminal, file manager and multi-exec",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "ServerLife",
          "Terminal": "false",
          "Type": "Application"
        }
      }
    },
    "deb": {
      "depends": [
        "openssh-client",
        "libnotify4",
        "libsecret-1-0",
        "xdg-utils"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": null,
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevenGravy/serverlife.git"
  },
  "bugs": {
    "url": "https://github.com/stevenGravy/serverlife/issues"
  },
  "homepage": "https://github.com/stevenGravy/serverlife#readme"
}
